{
  "name": "plink",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest",
    "e2e": "EXPO_PUBLIC_SANDBOX_PURCHASES=1 expo export --platform web && node e2e/run.js",
    "assets": "node scripts/generate-assets.js",
    "doctor": "expo-doctor",
    "bundle:check": "expo export --platform ios --platform android --output-dir dist-native",
    "prebuild:check": "node scripts/prebuild-check.js",
    "build:dev:ios": "eas build --profile development --platform ios",
    "build:dev:android": "eas build --profile development --platform android",
    "build:dev:sim": "eas build --profile development-simulator --platform ios",
    "start:dev": "expo start --dev-client"
  },
  "dependencies": {
    "@expo/metro-runtime": "^57.0.16",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-native/assets-registry": "^0.87.1",
    "@supabase/supabase-js": "^2.117.2",
    "@tanstack/react-query": "^5.104.1",
    "expo": "^57.0.26",
    "expo-clipboard": "57.0.2",
    "expo-constants": "^57.0.20",
    "expo-crypto": "^57.0.3",
    "expo-dev-client": "57.0.19",
    "expo-file-system": "57.0.7",
    "expo-font": "^57.0.4",
    "expo-haptics": "^57.0.3",
    "expo-linking": "^57.0.11",
    "expo-media-library": "57.0.5",
    "expo-notifications": "^57.0.21",
    "expo-router": "^57.0.24",
    "expo-sharing": "^57.0.22",
    "expo-splash-screen": "57.0.9",
    "expo-status-bar": "^57.0.1",
    "expo-system-ui": "57.0.4",
    "html2canvas": "1.4.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "^0.21.3",
    "react-native-worklets": "0.10.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.5",
    "playwright-core": "^1.63.0",
    "react-test-renderer": "19.2.3",
    "typescript": "^6.0.3"
  }
}